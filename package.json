{
  "name": "node-kimai",
  "version": "1.0.1",
  "description": "TypeScript API client SDK for Kimai time-tracking software",
  "sideEffects": false,
  "license": "MIT",
  "author": "Max Soukhomlinov",
  "repository": {
    "type": "git",
    "url": "https://github.com/msoukhomlinov/node-kimai.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./resources": {
      "import": {
        "types": "./dist/resources/index.d.mts",
        "default": "./dist/resources/index.mjs"
      },
      "require": {
        "types": "./dist/resources/index.d.ts",
        "default": "./dist/resources/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/types/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.mts",
        "default": "./dist/errors.mjs"
      },
      "require": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "docs/API.md",
    "MCP_TOOL_MANIFEST.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run coverage",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "npm run clean && npm run verify"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "kimai",
    "api",
    "client",
    "sdk",
    "time-tracking",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7",
    "@eslint/js": "^9.17.0",
    "globals": "^15.14.0",
    "rimraf": "^6.0.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
