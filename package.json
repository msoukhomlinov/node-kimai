{
  "name": "node-kimai",
  "version": "1.0.0",
  "description": "TypeScript API client SDK for Kimai time-tracking software",
  "license": "MIT",
  "author": "Max Soukhomlinov",
  "repository": {
    "type": "git",
    "url": "https://github.com/msoukhomlinov/node-kimai.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./resources": {
      "import": {
        "types": "./dist/resources/index.d.mts",
        "default": "./dist/resources/index.mjs"
      },
      "require": {
        "types": "./dist/resources/index.d.ts",
        "default": "./dist/resources/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/types/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.mts",
        "default": "./dist/errors.mjs"
      },
      "require": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "kimai",
    "api",
    "client",
    "sdk",
    "time-tracking",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
