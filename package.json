{
  "name": "node-kimai",
  "version": "2.0.1",
  "description": "TypeScript API client SDK for Kimai time-tracking software",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Max Soukhomlinov",
  "repository": {
    "type": "git",
    "url": "https://github.com/msoukhomlinov/node-kimai.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./resources": {
      "import": {
        "types": "./dist/resources/index.d.ts",
        "default": "./dist/resources/index.js"
      },
      "require": {
        "types": "./dist/resources/index.d.cts",
        "default": "./dist/resources/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/types/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/errors.cjs"
      }
    },
    "./capabilities": {
      "import": {
        "types": "./dist/capabilities.d.ts",
        "default": "./dist/capabilities.js"
      },
      "require": {
        "types": "./dist/capabilities.d.cts",
        "default": "./dist/capabilities.cjs"
      }
    },
    "./package.json": "./package.json",
    "./untrusted": {
      "import": {
        "types": "./dist/untrusted.d.ts",
        "default": "./dist/untrusted.js"
      },
      "require": {
        "types": "./dist/untrusted.d.cts",
        "default": "./dist/untrusted.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.js"
      },
      "require": {
        "types": "./dist/mcp/index.d.cts",
        "default": "./dist/mcp/index.cjs"
      }
    },
    "./operations": {
      "import": {
        "types": "./dist/operations/index.d.ts",
        "default": "./dist/operations/index.js"
      },
      "require": {
        "types": "./dist/operations/index.d.cts",
        "default": "./dist/operations/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "docs/API.md",
    "MCP_TOOL_MANIFEST.md",
    "MCP_TOOL_OVERRIDES.json",
    "capabilities.json",
    "capabilities.schema.json",
    "MCP_TOOL_CATALOG.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run public-surface && npm run capabilities:check && npm run capabilities:check:fixture && npm run mcp:project:check && npm run catalog:check && npm run mcp:check-surface && npm run coverage",
    "plan:derive": "node scripts/derive-plan.mjs",
    "capabilities:build": "node scripts/generate-capabilities.mjs",
    "capabilities:check": "node scripts/check-capabilities.mjs",
    "capabilities:check:fixture": "node scripts/check-negative-fixture.mjs",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "npm run clean && npm run verify && npm run capabilities:check:ship && npm run verify:pack",
    "prepack": "npm run build",
    "verify:pack": "node scripts/verify-pack.mjs",
    "capabilities:check:ship": "node scripts/check-capabilities.mjs --ship",
    "public-surface": "node scripts/public-surface.mjs",
    "mcp:project": "node scripts/project-mcp-tools.mjs",
    "mcp:project:check": "node scripts/project-mcp-tools.mjs --check --check-example",
    "catalog:build": "node scripts/build-tool-catalog.mjs",
    "catalog:check": "node scripts/build-tool-catalog.mjs --check",
    "mcp:check-surface": "node scripts/check-mcp-surface.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "kimai",
    "api",
    "client",
    "sdk",
    "time-tracking",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3",
    "@eslint/js": "^9.17.0",
    "globals": "^15.14.0",
    "rimraf": "^6.0.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
