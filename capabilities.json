              "file": "test/resources/timesheet.test.ts",
              "title": "returns the compact TimesheetSummary for a unique begin filter"
            },
            {
              "id": "timesheets.resolve.miss",
              "file": "test/resources/timesheet.test.ts",
              "title": "returns null when the begin filter matches no timesheet"
            },
            {
